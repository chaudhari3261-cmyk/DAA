Q 5. Write a program to implement removal of recursion for- Binomial Coefficient 
B(n,m)= B(n-1, m-1 ) + B (n-1,m), B(n,n) = B(n,0) = 1

#include <iostream>
#include <algorithm>   
using namespace std;
int binomialCoefficient(int n, int m){
    int B[n + 1][m + 1];
    for (int i = 0; i <= n; i++) {
        for (int j = 0; j <= min(i, m); j++){
            if (j == 0 || j == i)
                B[i][j] = 1; else
                B[i][j] = B[i - 1][j - 1] + B[i - 1][j];}}
    return B[n][m];}
int main(){
    int n, m;
    cout << "Enter value of n: ";
    cin >> n;
    cout << "Enter value of m: ";
    cin >> m;
    if (m > n || n < 0 || m < 0){
        cout << "Invalid input!" << endl;
        return 0;}
    cout << "Binomial Coefficient C(" << n << "," << m << ") = "
<< binomialCoefficient(n, m);
    return 0;}
