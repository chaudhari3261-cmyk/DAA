 
Q 8. Write a program to implement Weighted UNION and Collapsing FIND operations 

#include <iostream>
using namespace std;
#define MAX 100
int parent[MAX];
void makeSet(int n){
    for (int i = 0; i < n; i++)
        parent[i] = -1;}
int find(int x){
    if (parent[x] < 0)
        return x;
    return parent[x] = find(parent[x]);}
void weightedUnion(int a, int b){
    int rootA = find(a);
    int rootB = find(b);
    if (rootA == rootB){
        cout << "Both elements are already in the same set.\n"; return;}
    if (parent[rootA] <= parent[rootB]){
        parent[rootA] += parent[rootB];
        parent[rootB] = rootA;}
    else{
        parent[rootB] += parent[rootA];
        parent[rootA] = rootB;}}
void display(int n){
    cout << "\nParent Array:\n";
    for (int i = 0; i < n; i++)
        cout << parent[i] << " ";
    cout << endl;}
int main(){
    int n;
    cout << "Enter number of elements: ";
    cin >> n;
    makeSet(n);
    weightedUnion(0, 1);
    weightedUnion(2, 3);
    weightedUnion(1, 2);
    weightedUnion(4, 5);
    display(n);
    cout << "\nRepresentative of element 3 = " << find(3) << endl;
    cout << "Representative of element 5 = " << find(5) << endl;
    display(n);
    return 0;}
