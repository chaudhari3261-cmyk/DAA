
Q 4. Write a program for searching element form given array using binary search for 
n=1000,2000,3000. Find exact time of execution 

#include <iostream> 
#include <chrono> 
using namespace std; 
using namespace chrono; 
int binarySearch(int arr[], int n, int key) { 
int low = 0, high = n - 1; 
while (low <= high) { 
int mid = low + (high - low) / 2; 
if (arr[mid] == key) 
return mid; 
else if (arr[mid] < key) 
low = mid + 1; else 
high = mid - 1; } 
return -1; } 
int main() { 
int sizes[] = {1000, 2000, 3000}; 
for (int s = 0; s < 3; s++) { 
int n = sizes[s]; 
int *arr = new int[n]; 
for (int i = 0; i < n; i++) 
arr[i] = i + 1; 
int key = n;  
auto start = high_resolution_clock::now(); 
int result = binarySearch(arr, n, key); 
auto stop = high_resolution_clock::now(); 
auto duration = duration_cast<nanoseconds>(stop - start); 
cout << "Array Size = " << n << endl; 
if (result != -1) 
cout << "Element found at index " << result << endl; else 
cout << "Element not found" << endl; 
cout << "Execution Time = " 
<< duration.count() 
<< " nanoseconds\n\n"; 
delete[] arr; } 
return 0; }

